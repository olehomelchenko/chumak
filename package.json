{
  "name": "chumak",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based data wrangling tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx,css,html,json,md,yml}": "prettier --write"
  },
  "dependencies": {
    "@preact/signals": "^2.5.1",
    "arquero": "^6.0.1",
    "jsep": "^1.4.0",
    "papaparse": "^5.5.1",
    "preact": "^10.28.2",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/preact": "^3.2.4",
    "@types/papaparse": "^5.3.15",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.49",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8"
  }
}
